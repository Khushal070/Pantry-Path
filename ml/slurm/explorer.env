# Settings for running the search on Northeastern's Explorer cluster.
# Every __SET_ME__ must be filled in from your allocation and the cluster documentation;
# none of them are guessed here. setup_env.sh and submit.sh refuse to run until they are.

# Slurm: the GPU partition and --gres value for one GPU, and the time per array task
PP_PARTITION=__SET_ME__
PP_GPU_GRES=__SET_ME__
PP_TIME=__SET_ME__
# Slurm: a CPU partition and time limit for the aggregate job
PP_AGG_PARTITION=__SET_ME__
PP_AGG_TIME=__SET_ME__
# Slurm account, if your allocation needs one (leave empty otherwise)
PP_ACCOUNT=
# Array tasks running at once
PP_MAX_PARALLEL=4

# The environment module that provides Python 3.12 (see `module avail python`)
PP_PYTHON_MODULE=__SET_ME__
# Shared storage for the virtual environments, model weights and job logs
PP_ROOT=__SET_ME__

# Model server per task: vllm, or ollama as the fallback
PP_SERVER=vllm
PP_VLLM_VERSION=0.32.0
PP_OLLAMA_VERSION=0.40.11
