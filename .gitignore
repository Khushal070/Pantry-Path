__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
node_modules/
.next/
dist/
.env
.env.local
.DS_Store
Thumbs.db


# Data pipeline
data-pipeline/.venv/
data-pipeline/data/raw/
data-pipeline/data/interim/
# data-pipeline/data/processed/: DVC lists its tracked outputs in data/processed/.gitignore
data-pipeline/logs/*
!data-pipeline/logs/.gitkeep
data-pipeline/results/*
!data-pipeline/results/.gitkeep
data-pipeline/reports/stats_prev.json
.ruff_cache/
.pytest_cache/

# Model pipeline: MLflow store, LLM reply caches and every report folder. The one
# exception is reports/final/: commit only the reports/final/<id>/ folder of the run being
# promoted (select promote reads it from Git), never the other final runs (ml/README.md)
ml/mlruns/
ml/cache/
ml/reports/*
!ml/reports/final/
ml/pytest-report.xml
