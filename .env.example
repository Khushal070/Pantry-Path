# Backend (backend/README.md). demo = offline, synthetic stores, nothing else needed (the
# default); live = the champion models and live store data (needs everything below).
PANTRYPATH_MODE=demo
# true when the app is served over HTTPS: the login cookie is then sent over HTTPS only
PANTRYPATH_SECURE_COOKIES=false
# Backend database (Postgres). Locally: the Docker one, `docker compose up -d` in backend/.
# The owner runs the migrations (`alembic upgrade head` in backend/); the app connects as
# pp_auth and pp_profile, which the first migration creates with these passwords (pick
# your own, e.g. python3 -c 'import secrets; print(secrets.token_urlsafe(24))').
PANTRYPATH_DB_OWNER_URL=postgresql+psycopg://pantrypath_owner:local-only-owner@127.0.0.1:5433/pantrypath
PANTRYPATH_DB_AUTH_PASSWORD=
PANTRYPATH_DB_PROFILE_PASSWORD=
# The app's two connections, with the same passwords as above
PANTRYPATH_DB_AUTH_URL=postgresql+psycopg://pp_auth:<auth password>@127.0.0.1:5433/pantrypath
PANTRYPATH_DB_PROFILE_URL=postgresql+psycopg://pp_profile:<profile password>@127.0.0.1:5433/pantrypath
# Encrypts the saved food preferences: v1:<key>, a key from
# python -c "from app.crypto import new_key; print(new_key())" (in backend/). Newest first
# when changing keys (v2:<new>,v1:<old>). Losing it loses every saved preference.
PANTRYPATH_PROFILE_KEYS=
# Minutes a chat stays in memory after its last message (chats are never saved)
PANTRYPATH_CHAT_IDLE_MIN=20

# Kroger Products and Locations API (https://developer.kroger.com/)
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Self-hosted language model (ml/): servers and model ids live in ml/configs/candidates.yaml.
# Optional overrides for one run: MODEL_SERVER_URL (base URL without /v1, e.g. a vLLM server
# on a GPU machine or the Cloud Run URL) and MODEL_NAME (replaces the chosen candidate's
# model id).
MODEL_SERVER_URL=
MODEL_NAME=
# The deployed model server is private. For a short job set MODEL_SERVER_TOKEN to
# "$(gcloud auth print-identity-token)" (lasts about an hour). For the backend set
# MODEL_SERVER_AUTH=google: it mints and refreshes ID tokens from its own credentials.
MODEL_SERVER_TOKEN=
MODEL_SERVER_AUTH=

# MLflow: empty = a local SQLite store in ml/mlruns/. Point it at a shared tracking server
# so the team sees one set of runs.
MLFLOW_TRACKING_URI=

# Open Food Facts and Nominatim ask clients to identify themselves with an app name and contact
APP_USER_AGENT=PantryPath/0.1 (contact: your-team-email@example.com)

# LLM used by the data pipeline. Any provider's key works: Gemini, Anthropic (Claude) or OpenAI.
# The provider is guessed from the key's format; set LLM_PROVIDER (gemini | anthropic | openai) to be explicit.
# LLM_MODEL is optional (each provider has a default in data-pipeline/config/pipeline.yaml).
# In the app's live mode the same key turns on "Not right? Ask a stronger model": when the
# local model gets a dish's ingredients wrong, the shopper can have this model redo them
# (backend/app/stronger_model.py). Only the dish name is sent. Empty = the option is off.
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=

# Store APIs used by the request flow (Target via RedCircle is the fallback)
REDCIRCLE_API_KEY=

# Pipeline alert emails via Gmail SMTP (optional: without them, alerts are only logged).
# ALERT_SMTP_USER = the Gmail account that sends, ALERT_SMTP_PASSWORD = its app password
# (myaccount.google.com/apppasswords; needs 2-Step Verification), ALERT_EMAIL_TO = where
# alerts go. Set all three to use your own Gmail; empty = the project addresses in
# data-pipeline/config/pipeline.yaml.
ALERT_EMAIL_TO=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
# Model pipeline notifications also go to Slack when this is set
SLACK_WEBHOOK_URL=

# GCP, for ml/ registry pushes, deploy and rollback from a laptop (CI reads them from the
# repository variables). Create everything with infra/gcp/bootstrap.sh.
GCP_PROJECT_ID=
GCP_REGION=
AR_DOCKER_REPO=
AR_GENERIC_REPO=
CLOUD_RUN_SERVICE=
RUN_SERVICE_ACCOUNT=
